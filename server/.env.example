# Server
PORT=4000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:3000

# Auth
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=7d

# Database
MONGODB_URI=mongodb://localhost:27017/interview-prep-kit

# LLM - Google Gemini API (generativelanguage.googleapis.com). This is the
# *developer* API, a separate product from the consumer Gemini app/Pro
# subscription - get a free API key at https://aistudio.google.com/apikey
# (no billing required for the free tier). If GEMINI_MODEL 404s, check
# https://ai.google.dev/gemini-api/docs/models for the current free-tier
# model names.
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-3.6-flash

# Scraping - Browserbase (https://browserbase.com). Optional: if unset,
# the scraper falls back to a plain axios+cheerio fetch, which is what
# is used against the local fixture site for the batch command.
BROWSERBASE_API_KEY=
BROWSERBASE_PROJECT_ID=
